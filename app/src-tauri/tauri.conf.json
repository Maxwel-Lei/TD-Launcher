{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TD Launcher",
  "version": "0.2.0",
  "identifier": "com.tdxuezhang.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TD 工程启动器",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/template/*"]
  }
}
